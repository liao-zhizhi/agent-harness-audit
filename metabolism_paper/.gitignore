# LaTeX intermediates. The sources are main.tex and references.bib; everything
# below is regenerated by ./build.sh, which pins SOURCE_DATE_EPOCH so that the
# PDF hash in main.sha256 is reproducible rather than a one-off reading.
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
*.xdv

# Release archives are built, not stored: pack_v2.py rewrites the zip
# deterministically from main.tex and references.bib, so committing a copy
# would only create a second artefact that can drift from the sources.
*.zip
